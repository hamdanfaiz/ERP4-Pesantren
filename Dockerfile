FROM oven/bun:1.4.4 AS build

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_SUPABASE_ACADEMIC_IMPORT_ENABLED
ARG VITE_SUPABASE_BOARDING_ASSIGNMENTS_RUNTIME_ENABLED
ARG VITE_SUPABASE_BOARDING_ATTENDANCE_IMPORT_ENABLED
ARG VITE_SUPABASE_BOARDING_ATTENDANCE_RUNTIME_ENABLED
ARG VITE_SUPABASE_BOARDING_DISCIPLINE_IMPORT_ENABLED
ARG VITE_SUPABASE_BOARDING_DISCIPLINE_RUNTIME_ENABLED
ARG VITE_SUPABASE_BOARDING_FACILITY_OPS_IMPORT_ENABLED
ARG VITE_SUPABASE_BOARDING_FACILITY_OPS_RUNTIME_ENABLED
ARG VITE_SUPABASE_BOARDING_PERMITS_IMPORT_ENABLED
ARG VITE_SUPABASE_BOARDING_PERMITS_RUNTIME_ENABLED
ARG VITE_SUPABASE_BOARDING_RUNTIME_ENABLED
ARG VITE_SUPABASE_COMMUNICATION_ANNOUNCEMENTS
ARG VITE_SUPABASE_COMMUNICATION_IMPORT_ENABLED
ARG VITE_SUPABASE_FACILITY_BOOKINGS_IMPORT_ENABLED
ARG VITE_SUPABASE_GA_ASSETS_IMPORT_ENABLED
ARG VITE_SUPABASE_HEALTHCARE_IMPORT_ENABLED
ARG VITE_SUPABASE_LMS_IMPORT_ENABLED
ARG VITE_SUPABASE_MARKETPLACE_IMPORT_ENABLED
ARG VITE_SUPABASE_MASTER_DATA_IMPORT_ENABLED
ARG VITE_SUPABASE_MASTER_DATA_RUNTIME_ENABLED
ARG VITE_SUPABASE_PPDB_DOCUMENTS_RUNTIME_ENABLED
ARG VITE_SUPABASE_PPDB_FINANCE_BILLS_ENABLED
ARG VITE_SUPABASE_PPDB_ONBOARDING_RUNTIME_ENABLED
ARG VITE_SUPABASE_PPDB_RUNTIME_ENABLED
ARG VITE_SUPABASE_SYSTEM_SETTINGS
ARG VITE_SUPABASE_SYSTEM_SETTINGS_IMPORT_ENABLED
ARG VITE_SUPABASE_TAHFIDZ_IMPORT_ENABLED
ARG VITE_SUPABASE_TAHFIDZ_RUNTIME_ENABLED
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_SUPABASE_ACADEMIC_IMPORT_ENABLED=$VITE_SUPABASE_ACADEMIC_IMPORT_ENABLED
ENV VITE_SUPABASE_BOARDING_ASSIGNMENTS_RUNTIME_ENABLED=$VITE_SUPABASE_BOARDING_ASSIGNMENTS_RUNTIME_ENABLED
ENV VITE_SUPABASE_BOARDING_ATTENDANCE_IMPORT_ENABLED=$VITE_SUPABASE_BOARDING_ATTENDANCE_IMPORT_ENABLED
ENV VITE_SUPABASE_BOARDING_ATTENDANCE_RUNTIME_ENABLED=$VITE_SUPABASE_BOARDING_ATTENDANCE_RUNTIME_ENABLED
ENV VITE_SUPABASE_BOARDING_DISCIPLINE_IMPORT_ENABLED=$VITE_SUPABASE_BOARDING_DISCIPLINE_IMPORT_ENABLED
ENV VITE_SUPABASE_BOARDING_DISCIPLINE_RUNTIME_ENABLED=$VITE_SUPABASE_BOARDING_DISCIPLINE_RUNTIME_ENABLED
ENV VITE_SUPABASE_BOARDING_FACILITY_OPS_IMPORT_ENABLED=$VITE_SUPABASE_BOARDING_FACILITY_OPS_IMPORT_ENABLED
ENV VITE_SUPABASE_BOARDING_FACILITY_OPS_RUNTIME_ENABLED=$VITE_SUPABASE_BOARDING_FACILITY_OPS_RUNTIME_ENABLED
ENV VITE_SUPABASE_BOARDING_PERMITS_IMPORT_ENABLED=$VITE_SUPABASE_BOARDING_PERMITS_IMPORT_ENABLED
ENV VITE_SUPABASE_BOARDING_PERMITS_RUNTIME_ENABLED=$VITE_SUPABASE_BOARDING_PERMITS_RUNTIME_ENABLED
ENV VITE_SUPABASE_BOARDING_RUNTIME_ENABLED=$VITE_SUPABASE_BOARDING_RUNTIME_ENABLED
ENV VITE_SUPABASE_COMMUNICATION_ANNOUNCEMENTS=$VITE_SUPABASE_COMMUNICATION_ANNOUNCEMENTS
ENV VITE_SUPABASE_COMMUNICATION_IMPORT_ENABLED=$VITE_SUPABASE_COMMUNICATION_IMPORT_ENABLED
ENV VITE_SUPABASE_FACILITY_BOOKINGS_IMPORT_ENABLED=$VITE_SUPABASE_FACILITY_BOOKINGS_IMPORT_ENABLED
ENV VITE_SUPABASE_GA_ASSETS_IMPORT_ENABLED=$VITE_SUPABASE_GA_ASSETS_IMPORT_ENABLED
ENV VITE_SUPABASE_HEALTHCARE_IMPORT_ENABLED=$VITE_SUPABASE_HEALTHCARE_IMPORT_ENABLED
ENV VITE_SUPABASE_LMS_IMPORT_ENABLED=$VITE_SUPABASE_LMS_IMPORT_ENABLED
ENV VITE_SUPABASE_MARKETPLACE_IMPORT_ENABLED=$VITE_SUPABASE_MARKETPLACE_IMPORT_ENABLED
ENV VITE_SUPABASE_MASTER_DATA_IMPORT_ENABLED=$VITE_SUPABASE_MASTER_DATA_IMPORT_ENABLED
ENV VITE_SUPABASE_MASTER_DATA_RUNTIME_ENABLED=$VITE_SUPABASE_MASTER_DATA_RUNTIME_ENABLED
ENV VITE_SUPABASE_PPDB_DOCUMENTS_RUNTIME_ENABLED=$VITE_SUPABASE_PPDB_DOCUMENTS_RUNTIME_ENABLED
ENV VITE_SUPABASE_PPDB_FINANCE_BILLS_ENABLED=$VITE_SUPABASE_PPDB_FINANCE_BILLS_ENABLED
ENV VITE_SUPABASE_PPDB_ONBOARDING_RUNTIME_ENABLED=$VITE_SUPABASE_PPDB_ONBOARDING_RUNTIME_ENABLED
ENV VITE_SUPABASE_PPDB_RUNTIME_ENABLED=$VITE_SUPABASE_PPDB_RUNTIME_ENABLED
ENV VITE_SUPABASE_SYSTEM_SETTINGS=$VITE_SUPABASE_SYSTEM_SETTINGS
ENV VITE_SUPABASE_SYSTEM_SETTINGS_IMPORT_ENABLED=$VITE_SUPABASE_SYSTEM_SETTINGS_IMPORT_ENABLED
ENV VITE_SUPABASE_TAHFIDZ_IMPORT_ENABLED=$VITE_SUPABASE_TAHFIDZ_IMPORT_ENABLED
ENV VITE_SUPABASE_TAHFIDZ_RUNTIME_ENABLED=$VITE_SUPABASE_TAHFIDZ_RUNTIME_ENABLED

RUN bun run build
RUN rm -rf node_modules && bun install --production --frozen-lockfile

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/node_modules ./node_modules

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || '3000') + '/health/ready').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["node", "dist/server.cjs"]

