# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public PPDB intake is fail-closed until explicitly enabled on the trusted server.
# Set the tenant to the Firestore tenant document ID; never accept this value from the browser.
PUBLIC_PPDB_ENABLED=false
PUBLIC_PPDB_TENANT_ID=

# Firebase Storage is accessed by the trusted backend using its Cloud Run service account.
FIREBASE_STORAGE_BUCKET=graphite-ship-q5xj8.firebasestorage.app

# Optional provider credentials belong in Cloud Run Secret Manager, never browser storage or Firestore.
WA_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
SMTP_PASSWORD=

# Supabase login and RBAC. Real values belong in the gitignored .env file.
# Share that file privately with teammates. Do not commit secret keys or the database password.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
SUPABASE_DB_POOLER_HOST=
SUPABASE_DB_POOLER_URL=
