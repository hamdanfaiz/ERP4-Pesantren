# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public PPDB intake is fail-closed until explicitly enabled on the trusted server.
# Set the tenant to the Firestore tenant document ID; never accept this value from the browser.
PUBLIC_PPDB_ENABLED=false
PUBLIC_PPDB_TENANT_ID=

# Firebase Storage is accessed by the trusted backend using its Cloud Run service account.
FIREBASE_STORAGE_BUCKET=graphite-ship-q5xj8.firebasestorage.app

# Optional provider credentials belong in Cloud Run Secret Manager, never browser storage or Firestore.
WA_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
SMTP_PASSWORD=


# Supabase backend credentials are server-only (never add the service key to Vite/browser variables).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Keep Tahfidz's staged Supabase API disabled until schema, identity mapping, and data import are ready.
SUPABASE_TAHFIDZ_RUNTIME_ENABLED=false

# Enable only for a scheduled legacy import after a verified backup; disabled by default.
LEGACY_MASTER_DATA_IMPORT_ENABLED=false

# Separate random 32-byte hex secrets. Keep server-side and back them up securely.
PII_ENCRYPTION_KEY=
PII_FINGERPRINT_KEY=

# Enable only after tenant snapshot import/reconciliation and Santri, structure, and room-placement acceptance checks.
# This is a public build-time switch, not a secret. Requests still use Firebase Auth during this staged cutover.
VITE_SUPABASE_BOARDING_CUTOVER=false
