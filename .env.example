# Modul operasional aktif menggunakan Supabase; Firestore bukan sumber cadangan runtime.
# Biarkan semua flag SUPABASE_*_RUNTIME=false sampai migration skema, tenant/Admin, Auth,
# izin, dan uji alur pada environment non-production selesai. Impor data Firestore tidak diperlukan.

# GEMINI_API_KEY: Optional server-side credential for Gemini AI features.
# Set it in the deployment secret store or ignored local .env file; never prefix it with VITE_ or commit it.
GEMINI_API_KEY=

# TRUST_PROXY_HOPS: Exact count of trusted reverse proxies. Unset means 1 on Cloud Run (K_SERVICE)
# and 0 elsewhere. For self-managed installs, configure this in the host environment if needed.
TRUST_PROXY_HOPS=

# APP_URL: Public HTTPS base URL for this ERP installation.
# Used to build application links and authentication redirects. Set it per deployment.
APP_URL="https://your-erp-domain.example"
# Explicit public origin allowed by Supabase Auth for guardian account activation redirects.
PUBLIC_APP_URL="https://your-erp-domain.example"

# Public PPDB intake is fail-closed until explicitly enabled on the trusted server.
# ID tenant yang telah dibuat di Supabase; jangan menerima nilainya sebagai otoritas dari browser.
PUBLIC_PPDB_ENABLED=false
PUBLIC_PPDB_TENANT_ID=
# Portal pendaftaran mandiri Wali juga memakai PUBLIC_PPDB_TENANT_ID, dan perlu Supabase Auth
# Email Confirmation aktif serta PUBLIC_APP_URL masuk daftar redirect yang diizinkan.
# PUBLIC_PPDB_ENABLED mengatur penerimaan calon santri; pendaftaran Wali tidak memerlukan PPDB dibuka.
# Aktifkan runtime setelah tenant, migrasi, Auth, dan alur terkait diuji pada environment non-production.
SUPABASE_PUBLIC_PPDB_RUNTIME_ENABLED=false

# Provider credentials must be injected as server-side secrets for each deployment, never browser storage or tenant settings.
WA_GATEWAY_API_KEY=
SMTP_PASSWORD=

# Supabase login and RBAC. Real values belong in the gitignored .env file or a secret manager.
# Never commit or send .env files or secret keys through chat or issue trackers.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional trusted first-tenant bootstrap settings; never place a secret in VITE_*.
SUPABASE_AUTH_REDIRECT_URL=
BOOTSTRAP_TENANT_TYPE=
BOOTSTRAP_TENANT_TIME_ZONE=Asia/Jakarta
# Aktifkan Koperasi setelah migration diterapkan, tenant/Admin dibuat, dan kontrol ledger serta transaksi diuji.
SUPABASE_COOPERATIVE_RUNTIME_ENABLED=false
# Import arsip Firestore tidak diperlukan dan tetap dinonaktifkan.
SUPABASE_COOPERATIVE_IMPORT_ENABLED=false
# Import historis keuangan tetap dinonaktifkan; transaksi baru dicatat melalui alur Supabase.
SUPABASE_COOPERATIVE_FINANCIAL_IMPORT_APPLY_ENABLED=false

# PPDB admin list and workflow run through a tenant-scoped Supabase service route.
# Aktifkan setelah migration terkait ditinjau/diterapkan, profil tenant tersedia,
# serta alur PPDB dan Storage privat lulus uji. Data awal dapat dibuat melalui aplikasi.
SUPABASE_PPDB_RUNTIME_ENABLED=false
VITE_SUPABASE_PPDB_RUNTIME_ENABLED=false
# Jalur import arsip dinonaktifkan; jangan aktifkan untuk menyiapkan data tenant baru.
SUPABASE_PPDB_IMPORT_ENABLED=false
# Accepted-candidate onboarding requires PPDB, Master Data, and Boarding runtime contracts together.
SUPABASE_PPDB_ONBOARDING_RUNTIME_ENABLED=false
VITE_SUPABASE_PPDB_ONBOARDING_RUNTIME_ENABLED=false
# Admin document downloads go through the server and are logged; keep disabled until migration/policies and staging tests pass.
SUPABASE_PPDB_DOCUMENTS_RUNTIME_ENABLED=false
VITE_SUPABASE_PPDB_DOCUMENTS_RUNTIME_ENABLED=false
# Candidate PPDB fees share the Finance ledger. Keep off until migration 20270110000000,
# Finance/PPDB runtime, and an isolated rehearsal have all passed.
SUPABASE_PPDB_FINANCE_BILLS_ENABLED=false
VITE_SUPABASE_PPDB_FINANCE_BILLS_ENABLED=false
# Enable only after the tenant foundation and communication migration are applied,
# tenant/profile rows are provisioned, and the Supabase API is available.
# Supabase mode uses a separate screen with only tenant-scoped announcements. Messages, helpdesk, leave requests and templates remain unavailable until migrated.
SUPABASE_COMMUNICATION_RUNTIME_ENABLED=false
VITE_SUPABASE_COMMUNICATION_ANNOUNCEMENTS=false
SUPABASE_COMMUNICATION_IMPORT_ENABLED=false
VITE_SUPABASE_COMMUNICATION_IMPORT_ENABLED=false
# Aktifkan setelah migration pengaturan diterapkan dan SuperAdmin aktif dibuat; konfigurasi awal
# dimasukkan langsung melalui aplikasi, bukan diimpor dari Firestore.
SUPABASE_SYSTEM_SETTINGS_RUNTIME_ENABLED=false
VITE_SUPABASE_SYSTEM_SETTINGS=false
SUPABASE_SYSTEM_SETTINGS_IMPORT_ENABLED=false
VITE_SUPABASE_SYSTEM_SETTINGS_IMPORT_ENABLED=false
# Search response ratings store only tenant/user/rating metadata; raw search text is not recorded.
SUPABASE_SEARCH_FEEDBACK_RUNTIME_ENABLED=false
VITE_SUPABASE_SEARCH_FEEDBACK=false
# New payment proof uploads use the private Supabase bucket only after its migration is reviewed and applied.
SUPABASE_DASHBOARD_RUNTIME_ENABLED=false
VITE_SUPABASE_DASHBOARD_RUNTIME_ENABLED=false
SUPABASE_ACADEMIC_RUNTIME_ENABLED=false
VITE_SUPABASE_ACADEMIC_RUNTIME_ENABLED=false
# Import historis Akademik dinonaktifkan; alur operasional baru memakai data Supabase tenant.
SUPABASE_ACADEMIC_IMPORT_ENABLED=false
VITE_SUPABASE_ACADEMIC_IMPORT_ENABLED=false
# Kunci ini hanya untuk importer arsip lama yang dinonaktifkan; tidak diperlukan untuk instalasi baru.
SUPABASE_LEGACY_FINGERPRINT_KEY=
# CBT bank, scheduled exams, student attempts, and server-side scoring.
SUPABASE_CBT_RUNTIME_ENABLED=false
VITE_SUPABASE_CBT_RUNTIME_ENABLED=false
SUPABASE_CBT_IMPORT_ENABLED=false
# LMS catalog, enrollments, assignments, submissions, and progress on Supabase.
SUPABASE_LMS_RUNTIME_ENABLED=false
VITE_SUPABASE_LMS_RUNTIME_ENABLED=false
SUPABASE_LMS_IMPORT_ENABLED=false
VITE_SUPABASE_LMS_IMPORT_ENABLED=false
# UKS medical records and stock operations are restricted to Admin tenant; do not enable before role/RLS review.
SUPABASE_HEALTHCARE_RUNTIME_ENABLED=false
VITE_SUPABASE_HEALTHCARE_RUNTIME_ENABLED=false
SUPABASE_HEALTHCARE_IMPORT_ENABLED=false
VITE_SUPABASE_HEALTHCARE_IMPORT_ENABLED=false
SUPABASE_FINANCE_RUNTIME_ENABLED=false
SUPABASE_FINANCE_BUDGET_RUNTIME_ENABLED=false
SUPABASE_ENTERPRISE_UNITS_RUNTIME_ENABLED=false
VITE_SUPABASE_FINANCE_RUNTIME_ENABLED=false
SUPABASE_FINANCE_PROOF_STORAGE_RUNTIME_ENABLED=false
# Aktifkan setelah migration Tahfidz diterapkan, tenant/Admin dan profil Auth tersedia,
# serta hak akses dan alur setoran diuji. Tenant baru tidak memerlukan impor data lama.
SUPABASE_TAHFIDZ_RUNTIME_ENABLED=false
VITE_SUPABASE_TAHFIDZ_RUNTIME_ENABLED=false
SUPABASE_TAHFIDZ_IMPORT_ENABLED=false
VITE_SUPABASE_TAHFIDZ_IMPORT_ENABLED=false
# Alumni dan kelulusan memakai data tenant; aktifkan setelah migration dan alur kelulusan diuji.
SUPABASE_ALUMNI_RUNTIME_ENABLED=false
VITE_SUPABASE_ALUMNI_RUNTIME_ENABLED=false
# Katalog dan sirkulasi Supabase bersifat transaksional dan tenant-scoped. Aktifkan setelah migration,
# peminjaman/pengembalian, stok, dan keterkaitan santri diuji dengan record baru.
SUPABASE_LIBRARY_RUNTIME_ENABLED=false
SUPABASE_LIBRARY_DIGITAL_ASSETS_ENABLED=false
SUPABASE_LIBRARY_IMPORT_ENABLED=false
# Import riwayat peminjaman arsip tidak diperlukan untuk memulai katalog baru.
SUPABASE_LIBRARY_CIRCULATIONS_IMPORT_ENABLED=false
VITE_SUPABASE_LIBRARY_RUNTIME_ENABLED=false
# Master Data and asrama runtime cutover. Keep disabled until prerequisite migrations,
# tenant/profile provisioning, encrypted identity keys, and final auth/RLS review are complete.
SUPABASE_MASTER_DATA_RUNTIME_ENABLED=false
VITE_SUPABASE_MASTER_DATA_RUNTIME_ENABLED=false
# Import Master Data dari Firestore dinonaktifkan; data awal dibuat melalui formulir ERP.
SUPABASE_MASTER_DATA_IMPORT_ENABLED=false
VITE_SUPABASE_MASTER_DATA_IMPORT_ENABLED=false
SUPABASE_BOARDING_RUNTIME_ENABLED=false
VITE_SUPABASE_BOARDING_RUNTIME_ENABLED=false
# Boarding permits use a standalone Supabase-only screen. Keep disabled until migration 20261108000000,
# profile linkage, tenant provisioning, and final role/tenant checks have been completed.
SUPABASE_BOARDING_PERMITS_RUNTIME_ENABLED=false
VITE_SUPABASE_BOARDING_PERMITS_RUNTIME_ENABLED=false
SUPABASE_BOARDING_PERMITS_IMPORT_ENABLED=false
VITE_SUPABASE_BOARDING_PERMITS_IMPORT_ENABLED=false
# Kedisiplinan asrama memakai pencatatan Supabase tenant-scoped. Aktifkan setelah migration,
# profil/izin, dan pencatatan insiden baru lulus uji.
SUPABASE_BOARDING_DISCIPLINE_RUNTIME_ENABLED=false
VITE_SUPABASE_BOARDING_DISCIPLINE_RUNTIME_ENABLED=false
SUPABASE_BOARDING_DISCIPLINE_IMPORT_ENABLED=false
VITE_SUPABASE_BOARDING_DISCIPLINE_IMPORT_ENABLED=false
# Nightly boarding attendance uses dated sessions and audited, tenant-scoped status changes.
SUPABASE_BOARDING_ATTENDANCE_RUNTIME_ENABLED=false
VITE_SUPABASE_BOARDING_ATTENDANCE_RUNTIME_ENABLED=false
SUPABASE_BOARDING_ATTENDANCE_IMPORT_ENABLED=false
VITE_SUPABASE_BOARDING_ATTENDANCE_IMPORT_ENABLED=false
# Historical attendance snapshots require an Admin to assign the explicit represented date in preview.
SUPABASE_BOARDING_ASSIGNMENTS_RUNTIME_ENABLED=false
VITE_SUPABASE_BOARDING_ASSIGNMENTS_RUNTIME_ENABLED=false
# Audit fasilitas dan tiket perbaikan memakai RPC tenant-scoped; aktifkan setelah migration dan alur baru diuji.
SUPABASE_BOARDING_FACILITY_OPS_RUNTIME_ENABLED=false
VITE_SUPABASE_BOARDING_FACILITY_OPS_RUNTIME_ENABLED=false
SUPABASE_BOARDING_FACILITY_OPS_IMPORT_ENABLED=false
VITE_SUPABASE_BOARDING_FACILITY_OPS_IMPORT_ENABLED=false
# Inventaris dan stok GA memakai RPC tenant-scoped serta ledger append-only; aktifkan setelah migration,
# kontrol akses, dan transaksi stok baru lulus uji.
SUPABASE_GA_ASSETS_RUNTIME_ENABLED=false
VITE_SUPABASE_GA_ASSETS_RUNTIME_ENABLED=false
SUPABASE_GA_ASSETS_IMPORT_ENABLED=false
VITE_SUPABASE_GA_ASSETS_IMPORT_ENABLED=false
# Marketplace menyimpan katalog dan reservasi stok melalui RPC transaksional; aktifkan setelah migration,
# role, dan transaksi stok diuji dengan record baru.
SUPABASE_MARKETPLACE_RUNTIME_ENABLED=false
VITE_SUPABASE_MARKETPLACE_RUNTIME_ENABLED=false
SUPABASE_COOPERATIVE_RUNTIME_ENABLED=false
VITE_SUPABASE_COOPERATIVE_RUNTIME_ENABLED=false
# Import katalog/penjualan historis tidak diperlukan; transaksi baru menggunakan data tenant Supabase.
SUPABASE_COOPERATIVE_IMPORT_ENABLED=false
SUPABASE_MARKETPLACE_IMPORT_ENABLED=false
VITE_SUPABASE_MARKETPLACE_IMPORT_ENABLED=false
# Donation and waqf campaigns, receipts, donor records, and waqf assets use tenant-scoped audited RPCs.
# The prior screen only held sample/state data; no mock records should be imported as real financial history.
SUPABASE_DONATION_RUNTIME_ENABLED=false
VITE_SUPABASE_DONATION_RUNTIME_ENABLED=false
# Pemesanan fasilitas memakai pemeriksaan konflik tenant-scoped; data awal dicatat langsung di Supabase.
SUPABASE_FACILITY_BOOKINGS_RUNTIME_ENABLED=false
VITE_SUPABASE_FACILITY_BOOKINGS_RUNTIME_ENABLED=false
SUPABASE_FACILITY_BOOKINGS_IMPORT_ENABLED=false
VITE_SUPABASE_FACILITY_BOOKINGS_IMPORT_ENABLED=false
# HRIS Supabase runtime covers the tenant employee directory, manual attendance, and Admin-recorded leave requests/reviews.
# Leave balances/payroll, employee self-service, recruitment, biometrics, geofencing, and HR analytics remain unavailable.
SUPABASE_HRIS_RUNTIME_ENABLED=false
SUPABASE_HRIS_IMPORT_ENABLED=false
VITE_SUPABASE_HRIS_RUNTIME_ENABLED=false
# Tenant-scoped correspondence, audited review transitions, and private PDF attachments.
# Keep disabled until migration 20270117000000 is applied and verified in a non-production environment.
SUPABASE_DOCUMENT_RUNTIME_ENABLED=false
# Tenant-scoped contact directory and immutable interaction notes; campaigns are not sent by this module.
# Keep disabled until migration 20270118000000 is applied and verified in a non-production environment.
SUPABASE_CRM_RUNTIME_ENABLED=false
# Laundry orders, status events, and monthly quota estimates use tenant-scoped Supabase records.
# Keep disabled until migration 20261204000000 and non-production verification are complete.
SUPABASE_LAUNDRY_RUNTIME_ENABLED=false
VITE_SUPABASE_LAUNDRY_RUNTIME_ENABLED=false
# Server-only keys used to encrypt NIK/NISN, produce keyed duplicate fingerprints,
# and pseudonymize actors for durable Finance/PPDB rate limiting.
# Generate independent random 32-byte values, encoded as 64 hexadecimal characters.
PII_ENCRYPTION_KEY=
PII_FINGERPRINT_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
SUPABASE_DB_POOLER_HOST=
SUPABASE_DB_POOLER_URL=

