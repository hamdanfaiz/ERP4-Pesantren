# Application image built and tagged once for each release.
ERP_IMAGE=erp4-pesantren:local
ERP_HTTP_PORT=3000

# Exact trusted reverse-proxy hops. Use 0 for direct/private LAN access;
# use the actual count only when traffic is always routed through that proxy.
TRUST_PROXY_HOPS=0

# Per-installation Firebase web configuration. These values are public browser config,
# but they must point to the customer's Firebase project, never the developer project.
FIREBASE_PROJECT_ID=replace-with-customer-project-id
FIREBASE_WEB_API_KEY=replace-with-customer-web-api-key
FIREBASE_AUTH_DOMAIN=replace-with-customer-auth-domain
FIREBASE_APP_ID=replace-with-customer-web-app-id
FIREBASE_STORAGE_BUCKET=replace-with-customer-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=replace-with-customer-sender-id
FIRESTORE_DATABASE_ID=replace-with-customer-database-id

# Host-side file path; keep the JSON outside the repository and mount read-only.
FIREBASE_ADMIN_CREDENTIALS_FILE=./secrets/firebase-admin.json

# Public PPDB stays disabled until a tenant and operating process are deliberately configured.
PUBLIC_PPDB_ENABLED=false
PUBLIC_PPDB_TENANT_ID=
